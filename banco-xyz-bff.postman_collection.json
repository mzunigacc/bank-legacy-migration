                "web",
                "cuentas",
                "101"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Respuesta web contiene información completa\", function () {",
                  "    const json = pm.response.json();",
                  "",
                  "    pm.expect(json).to.have.property(\"cuentaId\");",
                  "    pm.expect(json).to.have.property(\"titular\");",
                  "    pm.expect(json).to.have.property(\"edad\");",
                  "    pm.expect(json).to.have.property(\"tipo\");",
                  "    pm.expect(json).to.have.property(\"saldo\");",
                  "    pm.expect(json).to.have.property(\"interesGenerado\");",
                  "    pm.expect(json).to.have.property(\"movimientos\");",
                  "});"
                ]
              }
            }
          ]
        },
